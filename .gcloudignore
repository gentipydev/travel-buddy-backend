# What `gcloud run deploy --source .` must NOT upload to Cloud Build.
# Keep secrets (.env) and local cruft out of the build context. The image
# itself is built from the Dockerfile (which IS uploaded) + ./app + requirements.
.git
.gitignore
.env
.env.*
.venv
venv
__pycache__
*.pyc
*.pyo
.pytest_cache
.mypy_cache
.coverage
.vscode
.idea
.DS_Store
docs
evals
tests
docker-compose.yml
