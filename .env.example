# --- Google Gemini (chat + tool use) -----------------------------------
# Two ways to reach Gemini; pick ONE per environment.
#
# 1) Developer API (default) — a single API key. Works from residential IPs.
#    Get a key at https://ai.google.dev/gemini-api/docs/api-key. SEPARATE from
#    GOOGLE_API_KEY below (Maps Platform) — different API, different credential.
GEMINI_API_KEY=
#
# 2) Vertex AI — REQUIRED on server hosts (e.g. Render). The Developer API
#    edge-blocks datacenter IPs with an HTML 403 even with billing on; Vertex
#    (aiplatform.googleapis.com) does not. Set GEMINI_USE_VERTEX=true and supply
#    a GCP project + service-account auth. Auth: paste the raw service-account
#    key JSON into GOOGLE_SERVICE_ACCOUNT_JSON, OR leave it empty to use
#    Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS file path /
#    GCP metadata server). Location stays "global" for the gemini-3.x tier.
GEMINI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Cohere (embeddings + reranker for RAG) ----------------------------
COHERE_API_KEY=

# --- Supabase (auth via JWKS, storage, Postgres) -----------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Postgres connection. Use the Supabase transaction pooler at port 6543
# (pgbouncer transaction mode) — required for asyncpg + prepared-statement
# tuning in app/db/engine.py.
DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<password>@aws-1-eu-west-2.pooler.supabase.com:6543/postgres

# --- App ---------------------------------------------------------------
# Comma-separated list of allowed CORS origins. 10.0.2.2 is the Android
# emulator's loopback to the host machine.
ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:3000

# --- Models (defaults shown; override only for A/B tests) --------------
# gemini-3.5-flash is the target tier; it was capacity-constrained on 2026-06-24
# (2.5-flash was a temporary fallback) but we've switched back to it now.
MODEL_CHAT=gemini-3.5-flash
MODEL_PERSONA_GATE=gemini-3.5-flash
MODEL_TITLE_GEN=gemini-3.5-flash
MODEL_SUMMARIZE=gemini-3.5-flash
EMBEDDING_MODEL=embed-multilingual-v3.0
RERANK_MODEL=rerank-multilingual-v3.0

# --- Google Maps Platform ----------------------------------------------
# Both `_enabled` flags are kill switches for cost control: set either to
# `false` (or leave the API key empty) to short-circuit the corresponding
# service. Trip saves still succeed, just without that enrichment.
GOOGLE_API_KEY=
GOOGLE_URL_SIGNING_SECRET=
GOOGLE_PLACES_ENABLED=true
GOOGLE_DIRECTIONS_ENABLED=true

# --- LLM cost-abuse guards (app/domain/usage_budget.py) -----------------
# Estimated USD per pricing.py; 0 disables a check. Per-user budget blocks
# chat with 429 until UTC midnight; the global ceiling is the kill-switch
# of last resort — LLM endpoints return 503 once today's total estimated
# spend crosses it. The ceiling's DB SUM is cached in-process for
# GLOBAL_BUDGET_CACHE_SECONDS. Stream cap bounds parallel /chat/stream
# generators per signed-in user.
DAILY_COST_BUDGET_USD_PER_USER=0.50
DAILY_COST_CEILING_USD_GLOBAL=20.0
GLOBAL_BUDGET_CACHE_SECONDS=60
MAX_CONCURRENT_STREAMS_PER_USER=2

# --- Logging -----------------------------------------------------------
# `json` is the production default (Render Logs filters per-field on JSON);
# set LOG_FORMAT=text locally for human-friendly output.
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Braintrust (LLM observability + evals) ----------------------------
# API key from https://www.braintrust.dev/app/settings/api-keys
# (auto-created by the `bt setup` wizard). Until the key is populated AND
# BRAINTRUST_ENABLED=true, the integration no-ops — local dev / CI / PRs
# without the secret run unchanged.
BRAINTRUST_API_KEY=
BRAINTRUST_PROJECT=travel-buddy
BRAINTRUST_ENABLED=false
# Privacy kill switch: set to false to strip request.message and
# assistant_text from spans (token counts + structural metadata still
# ship). Flag flip — no rebuild needed.
BRAINTRUST_LOG_USER_PAYLOADS=true
